<?xml version="1.0" encoding="UTF-8"?>
<!--
  Knowledge Bridge 日志配置
  ============================================================
  - 控制台：始终输出，供 `docker logs` / `docker compose logs` 使用
  - 滚动文件：按天切分 + 单文件大小限制，写入 ${LOG_PATH}/${LOG_FILE_NAME}.log
    历史文件：${LOG_PATH}/archive/${LOG_FILE_NAME}-YYYY-MM-DD.N.log.gz

  所有路径与阈值均可通过 application.yml / 环境变量覆盖：
    LOG_PATH                  日志目录（默认 ./logs，容器内建议 /app/logs）
    LOG_FILE_NAME             文件名基础（默认 knowledge-bridge）
    LOG_FILE_MAX_SIZE         单文件滚动阈值（默认 50MB）
    LOG_FILE_MAX_HISTORY      保留天数（默认 30）
    LOG_FILE_TOTAL_SIZE_CAP   归档总大小上限（默认 2GB）
    LOGGING_PATTERN_CONSOLE   控制台格式
    LOGGING_PATTERN_FILE      文件格式
  ============================================================
-->
<configuration scan="true" scanPeriod="60 seconds">

    <!-- 引入 Spring Boot 默认转换词（wEx、wex、clr 等），否则 %wEx 会报错 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 让 Spring Boot 贡献 application.yml 里的 logging.* 属性 -->
    <springProperty scope="context" name="LOG_PATH"
                    source="logging.file.path" defaultValue="./logs"/>
    <springProperty scope="context" name="LOG_FILE_NAME"
                    source="logging.file.name-base" defaultValue="knowledge-bridge"/>
    <springProperty scope="context" name="LOG_FILE_MAX_SIZE"
                    source="logging.logback.rollingpolicy.max-file-size" defaultValue="50MB"/>
    <springProperty scope="context" name="LOG_FILE_MAX_HISTORY"
                    source="logging.logback.rollingpolicy.max-history" defaultValue="30"/>
    <springProperty scope="context" name="LOG_FILE_TOTAL_SIZE_CAP"
                    source="logging.logback.rollingpolicy.total-size-cap" defaultValue="2GB"/>
    <springProperty scope="context" name="CONSOLE_PATTERN"
                    source="logging.pattern.console"
                    defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <springProperty scope="context" name="FILE_PATTERN"
                    source="logging.pattern.file"
                    defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n%wEx"/>

    <!-- 控制台 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 按天 + 大小 滚动文件 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_FILE_TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 错误独立文件，方便快速排障 -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${LOG_FILE_NAME}-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_FILE_TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 异步包装，降低日志 IO 对主流程的影响 -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>
    <appender name="ASYNC_FILE_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE_ERROR"/>
    </appender>

    <!-- 根据 Spring profile 调节级别（可选） -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_FILE_ERROR"/>
        </root>
    </springProfile>

    <springProfile name="!dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_FILE_ERROR"/>
        </root>
    </springProfile>

</configuration>
