# 本文件由 Docker Compose 和 deploy.sh 读取。真实 .env 不提交 Git。

# 本项目 HTTP 端口，同时用于宿主机和后端容器。
SERVER_PORT=8111

# 外部 MySQL；同一服务器通过 Docker 主机网关访问。
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=kb_bridge
DB_USER=''
DB_PASSWORD=''

# 外部 MinIO；应用只创建自己负责的私有桶。
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=''
MINIO_SECRET_KEY=''

# 改写与入库文件桶，由 bridge 写入和清理；两端名称一致。
RELEASES_BUCKET=knowledge-releases

# 原文与文档管理服务，经过 Docker 主机网关。
NOTES_URL=http://host.docker.internal:8311

# bridge 调用 notes-blog 的服务令牌，两端保持一致。
NOTES_SERVICE_TOKEN=''

# notes-blog 调用 bridge 的服务令牌，两端保持一致。
BRIDGE_SERVICE_TOKEN=''

# 索引服务，经过 Docker 主机网关。
VECTOR_URL=http://host.docker.internal:8700

# bridge 调用 KBVector 的服务令牌，两端保持一致。
VECTOR_SERVICE_TOKEN=''

# OpenClaw 插件 sharedSecret 必须设置为此值，也用于 Markdown 上传。
KB_SHARED_SECRET=''

# OpenAI 兼容服务根地址，不含 /v1。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
LLM_API_KEY=''
LLM_MODEL=qwen-plus

# 单次改写请求的超时秒数。
LLM_TIMEOUT_SECONDS=180

# OpenClaw 每次查询返回的最多文档数。
SEARCH_MAX_SOURCES=5
LOG_LEVEL=INFO

# 同时生成的改写作业数。
PROCESSING_CONCURRENCY=2

# 每个来源地址的入库请求上限，单位次/分钟。
INGEST_REQUESTS_PER_MINUTE=30

# 每个来源地址的知识查询上限，单位次/分钟。
QUERY_REQUESTS_PER_MINUTE=120

# 检索时补充最多两个等价查询，失败时使用原问题。
QUERY_REWRITE_ENABLED=true

# OpenClaw 单条资料的最大字符数。
SOURCE_MAX_CHARS=3000

# OpenClaw 所有资料合计的最大字符数。
CONTEXT_MAX_CHARS=10000
