# Copy this file to .env and fill in local values.
# Knowledge Bridge loads .env on application startup. Restart after changes.

# -------------------------
# Server / Spring
# -------------------------
SERVER_PORT=8111
# 绑定地址：127.0.0.1 = 仅本机访问，0.0.0.0 = 允许外部访问
SERVER_ADDRESS=0.0.0.0
SPRING_APPLICATION_NAME=knowledge-bridge
SPRING_JACKSON_DATE_FORMAT=yyyy-MM-dd'T'HH:mm:ss'Z'
SPRING_JACKSON_TIME_ZONE=UTC
SPRING_JACKSON_DEFAULT_PROPERTY_INCLUSION=non_null
# 控制台 ANSI 颜色：detect=自动（TTY 开启/管道关闭）、always=强制彩色、never=关闭
SPRING_OUTPUT_ANSI_ENABLED=detect

# -------------------------
# MySQL
# -------------------------
DB_URL=jdbc:mysql://127.0.0.1:3306/kb_bridge?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# -------------------------
# MyBatis Plus
# -------------------------
MYBATIS_PLUS_MAP_UNDERSCORE_TO_CAMEL_CASE=true
MYBATIS_PLUS_LOG_IMPL=org.apache.ibatis.logging.slf4j.Slf4jImpl

# -------------------------
# Actuator
# -------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized

# -------------------------
# Logging
# -------------------------
# 日志输出目录（本地开发用 ./logs；容器内请用 /app/logs 并在 compose 挂载到宿主机）
LOG_PATH=./logs
# 日志文件名基础，实际文件：${LOG_PATH}/${LOG_FILE_NAME}.log
LOG_FILE_NAME=knowledge-bridge
# 单个日志文件大小阈值，超过则滚动
LOG_FILE_MAX_SIZE=50MB
# 历史日志保留天数
LOG_FILE_MAX_HISTORY=30
# 所有历史归档的总大小上限
LOG_FILE_TOTAL_SIZE_CAP=2GB
LOGGING_PATTERN_CONSOLE=%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%-5level) %clr([%thread]){faint} %clr(%-40.40logger{39}){cyan} %clr(-){faint} %msg%n%wEx
LOGGING_PATTERN_FILE=%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n%wEx
LOGGING_LEVEL_KB_BRIDGE=INFO
LOGGING_LEVEL_KB_BRIDGE_CLIENT=DEBUG
LOGGING_LEVEL_KB_BRIDGE_SECURITY=WARN

# -------------------------
# RAGFlow
# -------------------------
RAGFLOW_BASE_URL=http://127.0.0.1:8091
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
RAGFLOW_TIMEOUT_MS=5000
RAGFLOW_RETRY_MAX_ATTEMPTS=3
RAGFLOW_RETRY_DELAY_MS=1000

# -------------------------
# Query routing
# -------------------------
KB_QUERY_ROUTE_STRATEGY=rule
# #kb 标签已内置为最高优先级路由（→ KB_ONLY），无需配置规则
KB_QUERY_DEFAULT_ROUTE=KB_PLUS_LLM
KB_QUERY_SCORE_THRESHOLD=0.2
KB_QUERY_MAX_SOURCES=5
KB_QUERY_MAX_CONTENT_LENGTH=2000
KB_QUERY_MAX_TOTAL_LENGTH=8000
KB_QUERY_MEMORY_ENABLED=false
KB_QUERY_DATASET_IDS=
KB_QUERY_METADATA_FILTER_ENABLED=false

# -------------------------
# MinIO
# -------------------------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_RAW_BUCKET=kb-raw
MINIO_PROCESSED_BUCKET=kb-processed

# -------------------------
# LLM / OpenAI-compatible API
# -------------------------
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=1200000
# 是否启用流式响应（SSE）。长 LLM 请求建议开启，避免长空闲连接被中间链路静默丢弃
LLM_STREAM_ENABLED=true
# 流式响应中两个 chunk 之间允许的最长间隔（毫秒），超过即认为连接已死。默认 120000（2 分钟）
LLM_STREAM_IDLE_TIMEOUT_MS=120000

# -------------------------
# Knowledge processing
# -------------------------
PROCESSOR_GUIDE_PROMPT_TEMPLATE=classpath:prompts/guide-template.md
PROCESSOR_QA_PROMPT_TEMPLATE=classpath:prompts/qa-template.md
PROCESSOR_VERSION=v1
PROCESSOR_MIN_QA_COUNT=3

# -------------------------
# Ingest
# -------------------------
INGEST_ASYNC_POOL_SIZE=4
INGEST_RETRY_MAX_ATTEMPTS=3
INGEST_RETRY_DELAY_MS=5000
INGEST_ORPHAN_TIMEOUT_MS=3600000

# -------------------------
# Security / OpenClaw HMAC
# -------------------------
KB_SHARED_SECRET=
KB_SECURITY_TIMESTAMP_TOLERANCE_MS=300000
KB_SECURITY_SIGNATURE_ALGORITHM=HmacSHA256
KB_SECURITY_RATE_LIMIT_PER_MINUTE=60


# -------------------------
# Unified personal knowledge (external services; no plugin changes)
# -------------------------
# The implementation rejects any other bucket name.
KB_UNIFIED_BUCKET=kb-content
BLOG_BRIDGE_TOKEN=
KB_VECTOR_URL=
KB_BRIDGE_SERVICE_TOKEN=
KB_UNIFIED_WORKER_ENABLED=true
KB_UNIFIED_LEASE_SECONDS=180
KB_UNIFIED_MAX_ATTEMPTS=8
# Optional independent file-ingest token; blank keeps the plugin's original KB_SHARED_SECRET contract.
FILE_INGEST_TOKEN=
